---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title?: string;
  isGalleryPage?: boolean;
}

const { 
  title = 'Visual Storyteller | Creative Photography',
  isGalleryPage = false
} = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- Modern fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Dark Mode Script -->
    <script is:inline>
      // Check theme preference
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      
      const theme = getTheme();
      document.documentElement.classList.toggle('dark', theme === 'dark');
      localStorage.setItem('theme', theme);
      
      window.toggleTheme = () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      }
    </script>
  </head>
  <body class="font-sans antialiased bg-white dark:bg-black text-zinc-900 dark:text-zinc-100 selection:bg-fuchsia-300 dark:selection:bg-fuchsia-600 selection:text-fuchsia-900 dark:selection:text-white">
    <!-- Cursor effect (creative element) -->
    <div id="cursor-blob" class="fixed w-64 h-64 rounded-full bg-gradient-to-br from-fuchsia-300/30 to-sky-300/30 dark:from-fuchsia-700/20 dark:to-sky-700/20 blur-3xl pointer-events-none opacity-0 transition-opacity duration-500 -z-10"></div>
    <div id="cursor-border" class="fixed w-6 h-6 rounded-full border-2 border-zinc-900 dark:border-zinc-100 pointer-events-none mix-blend-difference hidden md:block"></div>
    
    <!-- 3D layered header with staggered entrance animation -->
    <header class="fixed top-0 left-0 right-0 z-50 font-medium">
      <!-- Backdrop layer with blur -->
      <div class="absolute inset-0 bg-white/80 dark:bg-black/80 backdrop-blur-lg border-b border-zinc-200 dark:border-zinc-800 transform origin-top"></div>
      
      <div class="container mx-auto px-4 md:px-6 lg:px-8 relative z-10">
        <div class="flex items-center justify-between h-16 md:h-20">
          <!-- Logo with gradient hover effect -->
          <a href="/" class="group relative flex items-center">
            <span class="absolute -inset-x-3 -inset-y-2 scale-75 bg-gradient-to-r from-fuchsia-100 to-sky-100 dark:from-fuchsia-950 dark:to-sky-950 rounded-lg blur-md opacity-0 group-hover:opacity-100 transition-all duration-500"></span>
            <span class="relative text-lg md:text-xl font-bold tracking-tighter bg-clip-text text-transparent bg-gradient-to-r from-fuchsia-600 to-sky-600 dark:from-fuchsia-400 dark:to-sky-400">
              PRISM.lens
            </span>
          </a>
          
          <!-- Navigation -->
          <nav class="hidden md:flex items-center gap-8">
            <a href="/" class="group relative">
              <span class="absolute -inset-x-3 -inset-y-2 bg-zinc-100 dark:bg-zinc-800 rounded-lg opacity-0 transform scale-75 group-hover:opacity-100 group-hover:scale-100 transition-all duration-300"></span>
              <span class="relative">Gallery</span>
            </a>
            <a href="/about" class="group relative">
              <span class="absolute -inset-x-3 -inset-y-2 bg-zinc-100 dark:bg-zinc-800 rounded-lg opacity-0 transform scale-75 group-hover:opacity-100 group-hover:scale-100 transition-all duration-300"></span>
              <span class="relative">About</span>
            </a>
            
            <!-- Theme toggle with animation -->
            <button 
              id="theme-toggle"
              type="button"
              aria-label="Toggle theme"
              class="relative w-10 h-10 flex items-center justify-center overflow-hidden"
              onclick="toggleTheme()"
            >
              <span class="sr-only">Toggle theme</span>
              <!-- Sun icon -->
              <svg 
                class="absolute w-5 h-5 transition-all duration-500 rotate-0 dark:-rotate-90 scale-100 dark:scale-0" 
                fill="none" 
                stroke="currentColor" 
                viewBox="0 0 24 24" 
                xmlns="http://www.w3.org/2000/svg"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
              <!-- Moon icon -->
              <svg 
                class="absolute w-5 h-5 transition-all duration-500 rotate-90 dark:rotate-0 scale-0 dark:scale-100" 
                fill="none" 
                stroke="currentColor" 
                viewBox="0 0 24 24" 
                xmlns="http://www.w3.org/2000/svg"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
              </svg>
            </button>
          </nav>
          
          <!-- Mobile Menu Button -->
          <button 
            id="mobile-menu-button" 
            type="button" 
            class="md:hidden w-10 h-10 flex items-center justify-center"
            aria-label="Toggle menu"
          >
            <div class="w-6 flex flex-col items-end justify-center gap-1.5 group">
              <span class="block h-0.5 w-6 bg-zinc-900 dark:bg-zinc-100 transition-all ease-in-out duration-300 transform origin-left group-hover:w-4"></span>
              <span class="block h-0.5 w-4 bg-zinc-900 dark:bg-zinc-100 transition-all ease-in-out duration-300 group-hover:w-6"></span>
              <span class="block h-0.5 w-6 bg-zinc-900 dark:bg-zinc-100 transition-all ease-in-out duration-300 transform origin-left group-hover:w-5"></span>
            </div>
          </button>
        </div>
      </div>
      
      <!-- Mobile menu overlay -->
      <div id="mobile-menu" class="fixed inset-0 bg-white dark:bg-black z-40 flex flex-col justify-center items-center transform -translate-y-full transition-transform duration-500 ease-in-out">
        <nav class="flex flex-col items-center space-y-8 text-2xl">
          <a href="/" class="hover:text-fuchsia-600 dark:hover:text-fuchsia-400 transition-colors">Gallery</a>
          <a href="/about" class="hover:text-fuchsia-600 dark:hover:text-fuchsia-400 transition-colors">About</a>
          
          <button 
            onclick="toggleTheme()" 
            class="mt-4 py-2 px-4 border border-zinc-200 dark:border-zinc-800 rounded-full flex items-center gap-2 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors"
          >
            <span class="dark:hidden">Dark Mode</span>
            <span class="hidden dark:inline">Light Mode</span>
          </button>
        </nav>
        
        <!-- Close button -->
        <button 
          id="close-mobile-menu" 
          class="absolute top-6 right-6 w-10 h-10 flex items-center justify-center"
        >
          <span class="sr-only">Close menu</span>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </header>

    <!-- Page transition overlay -->
    <div id="page-transition" class="fixed inset-0 pointer-events-none z-50 flex items-center justify-center bg-white dark:bg-black transform translate-y-full">
      <div class="w-16 h-16 border-4 border-fuchsia-600 dark:border-fuchsia-400 border-t-transparent rounded-full animate-spin"></div>
    </div>

    <!-- Main content with reveal animation -->
    <main class="relative pt-24 md:pt-32 min-h-screen">
      <!-- Creative background elements -->
      <div class="absolute inset-0 overflow-hidden -z-10">
        <!-- Animated gradient circles -->
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-gradient-to-r from-fuchsia-100 to-sky-100 dark:from-fuchsia-900/20 dark:to-sky-900/20 rounded-full blur-3xl opacity-60 dark:opacity-30 animate-float"></div>
        <div class="absolute bottom-1/3 right-1/4 w-64 h-64 bg-gradient-to-r from-sky-100 to-fuchsia-100 dark:from-sky-900/20 dark:to-fuchsia-900/20 rounded-full blur-3xl opacity-60 dark:opacity-30 animate-float-delay"></div>
        
        <!-- Grid pattern -->
        <div class="absolute inset-0 grid grid-cols-12 gap-2 p-2 opacity-[0.02] dark:opacity-[0.02]">
          {Array(12).fill(0).map((_, i) => (
            Array(12).fill(0).map((_, j) => (
              <div class="aspect-square border border-zinc-900 dark:border-zinc-100 rounded-full"></div>
            ))
          ))}
        </div>
      </div>
      
      <div class="container mx-auto px-4 md:px-6 lg:px-8 reveal-content">
        <!-- Content injected here -->
        <slot />
      </div>
    </main>

    <!-- Minimal footer with text reveal animation -->
    <footer class="py-6 md:py-8 border-t border-zinc-200 dark:border-zinc-800">
      <div class="container mx-auto px-4 md:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
          <!-- Copyright text with reveal effect -->
          <p class="text-sm text-zinc-500 dark:text-zinc-400 overflow-hidden">
            <span class="inline-block reveal-text">© {new Date().getFullYear()} PRISM.lens • All rights reserved</span>
          </p>
          
          <!-- Social icons with hover effects -->
          <div class="flex items-center gap-6">
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="group">
              <span class="sr-only">Instagram</span>
              <svg class="w-5 h-5 text-zinc-700 dark:text-zinc-300 transform transition-transform duration-300 group-hover:scale-110 group-hover:text-fuchsia-600 dark:group-hover:text-fuchsia-400" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.148-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </a>
            <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="group">
              <span class="sr-only">Twitter</span>
              <svg class="w-5 h-5 text-zinc-700 dark:text-zinc-300 transform transition-transform duration-300 group-hover:scale-110 group-hover:text-sky-500 dark:group-hover:text-sky-400" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
              </svg>
            </a>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="group">
              <span class="sr-only">LinkedIn</span>
              <svg class="w-5 h-5 text-zinc-700 dark:text-zinc-300 transform transition-transform duration-300 group-hover:scale-110 group-hover:text-blue-600 dark:group-hover:text-blue-400" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Scripts for animations and interactivity -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // Mobile menu toggle
        const mobileMenuButton = document.getElementById('mobile-menu-button');
        const closeMobileMenuButton = document.getElementById('close-mobile-menu');
        const mobileMenu = document.getElementById('mobile-menu');
        
        if (mobileMenuButton && mobileMenu && closeMobileMenuButton) {
          mobileMenuButton.addEventListener('click', () => {
            mobileMenu.classList.remove('-translate-y-full');
            mobileMenu.classList.add('translate-y-0');
          });
          
          closeMobileMenuButton.addEventListener('click', () => {
            mobileMenu.classList.remove('translate-y-0');
            mobileMenu.classList.add('-translate-y-full');
          });
        }
        
        // Custom cursor effect
        const cursorBlob = document.getElementById('cursor-blob');
        const cursorBorder = document.getElementById('cursor-border');
        
        if (cursorBlob && cursorBorder && window.innerWidth > 768) {
          document.addEventListener('mousemove', (e) => {
            const { clientX: x, clientY: y } = e;
            
            // Show cursor effects when mouse moves
            cursorBlob.style.opacity = '1';
            
            // Position blob with lag effect
            cursorBlob.animate({
              left: `${x - 32}px`,
              top: `${y - 32}px`
            }, { duration: 3000, fill: 'forwards' });
            
            // Position border precisely
            cursorBorder.animate({
              left: `${x - 3}px`,
              top: `${y - 3}px`
            }, { duration: 200, fill: 'forwards' });
          });
          
          // Handle cursor effects on links and buttons
          const interactiveElements = document.querySelectorAll('a, button');
          interactiveElements.forEach(el => {
            el.addEventListener('mouseenter', () => {
              cursorBorder.classList.add('scale-150', 'opacity-50');
            });
            
            el.addEventListener('mouseleave', () => {
              cursorBorder.classList.remove('scale-150', 'opacity-50');
            });
          });
        }
        
        // Reveal animations on scroll
        const observeReveal = () => {
          const revealItems = document.querySelectorAll('.reveal-content, .reveal-text');
          
          const revealCallback = (entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
              }
            });
          };
          
          const revealObserver = new IntersectionObserver(revealCallback, {
            threshold: 0.1
          });
          
          revealItems.forEach(item => {
            revealObserver.observe(item);
          });
        };
        
        observeReveal();
        
        // Smooth page transitions
        const links = document.querySelectorAll('a[href^="/"]');
        const pageTransition = document.getElementById('page-transition');
        
        links.forEach(link => {
          link.addEventListener('click', (e) => {
            // Only intercept links to our own domain
            if (link.getAttribute('href').startsWith('/') && !link.getAttribute('target')) {
              e.preventDefault();
              const href = link.getAttribute('href');
              
              // Animate the transition
              pageTransition.classList.remove('translate-y-full');
              pageTransition.classList.add('translate-y-0');
              
              // Navigate after transition
              setTimeout(() => {
                window.location.href = href;
              }, 500);
            }
          });
        });
        
        // Hide transition overlay when page loads
        if (pageTransition) {
          setTimeout(() => {
            pageTransition.classList.add('translate-y-full');
            pageTransition.classList.remove('translate-y-0');
          }, 200);
        }
      });
    </script>
    
    <!-- Additional CSS animations -->
    <style is:inline>
      /* Fonts */
      body {
        font-family: 'Space Grotesk', sans-serif;
        letter-spacing: -0.015em;
      }
      
      /* Animations */
      @keyframes float {
        0% { transform: translate(0, 0) rotate(0deg); }
        50% { transform: translate(15px, -15px) rotate(5deg); }
        100% { transform: translate(0, 0) rotate(0deg); }
      }
      
      @keyframes float-delay {
        0% { transform: translate(0, 0) rotate(0deg); }
        50% { transform: translate(-15px, 10px) rotate(-5deg); }
        100% { transform: translate(0, 0) rotate(0deg); }
      }
      
      .animate-float {
        animation: float 20s ease-in-out infinite;
      }
      
      .animate-float-delay {
        animation: float-delay 15s ease-in-out infinite;
      }
      
      /* Content reveal animations */
      .reveal-content {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease, transform 1.2s ease;
      }
      
      .reveal-content.revealed {
        opacity: 1;
        transform: translateY(0);
      }
      
      .reveal-text {
        position: relative;
        transform: translateY(100%);
        transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      
      .reveal-text.revealed {
        transform: translateY(0);
      }
      
      /* Image hover effects for gallery */
      .image-card {
        transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
      }
      
      .image-card:hover {
        z-index: 10;
        transform: scale(1.03);
      }
      
      /* Scrollbar styling */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      
      ::-webkit-scrollbar-track {
        background: transparent;
      }
      
      ::-webkit-scrollbar-thumb {
        background: rgba(161, 161, 170, 0.3);
        border-radius: 4px;
      }
      
      ::-webkit-scrollbar-thumb:hover {
        background: rgba(161, 161, 170, 0.5);
      }
      
      /* Make sure the cursor elements are always in view */
      html, body {
        overflow-x: hidden;
        cursor: none;
      }
      
      @media (max-width: 768px) {
        html, body {
          cursor: auto;
        }
      }
    </style>
  </body>
</html>